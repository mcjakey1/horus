{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horus",
  "version": "0.1.0",
  "identifier": "art.horus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Horus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "publisher": "Jake Manahan",
    "copyright": "© 2026 Jake Manahan",
    "category": "GraphicsAndDesign",
    "shortDescription": "A local reference workbench for artists",
    "resources": {
      "resources/taxonomy.json": "resources/taxonomy.json",
      "resources/demo/manifest.json": "resources/demo/manifest.json",
      "resources/demo/images/*": "resources/demo/images/",
      "../src/fonts/OFL-*.txt": "licenses/",
      "ort/*": "ort/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" },
      "digestAlgorithm": "sha256"
    },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
